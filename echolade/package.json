{
  "name": "echolade",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @echolade/api dev",
    "dev:worker": "pnpm --filter @echolade/api dev:worker",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  },
  "version": "1.0.0",
  "description": "AI voice and audio production platform. Flagship: **Echolade Assurance** (segment-level tracking, pronunciation rules, script-to-audio verification, change-aware regeneration).",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "bullmq": "^6.5.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
